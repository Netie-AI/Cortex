# SOPS: only encrypted *.enc.* may be committed; plaintext secrets stay local
secrets/*.yaml
secrets/*.json
!secrets/*.example.yaml
!secrets/*.enc.yaml
!secrets/*.enc.json
utputFormat
myenv/
activeflow/
demo/dms-ui/node_modules/
demo/dms-ui/.next/
demo/logs/
data/dms_demo.duckdb
data/dms_ops.db
data/dms_photos/
data/codebase_ontology.db
# Same ops DB, second location: query_skills defaults here, and env.local.example
# points DMS_OPS_DB at it, so a running engine (or a plain pytest run) writes it.
# Rebuild with: python -m scripts.seed_ops_db
packs/data/dms_ops.db
packs/data/dms_ops.db-journal
packs/data/dms_photos/
# Engine runtime state — written by a running appliance, never source.
# Every one of these is regenerated on boot or on first run; committing them
# makes the tree diverge per-machine and (for telemetry/keys) leaks material.
data/engine/
data/bench/
data/workflows/
data/apps/
data/lakehouse/
data/ingest_drop/
data/samples/*.xlsx
CortexOS/data/

# AirGPT/Vertex working mirrors + runtime artifacts live OUTSIDE this repo
# (AirGPT app root = D:/AirGPT, its own git). The in-tree mirror carries a live
# env.local with API keys — must never be committable here.
CortexOS/AirGPT/
CortexOS/Vertex/
outputs/
bench/results/

