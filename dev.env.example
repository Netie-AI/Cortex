# Local dev only. Copy to dev.env (gitignored). Never bake this into an image.
# CORTEX_DEV_MODE is the dev-mode switch. PACK selects a vertical.
# CORTEX_PROFILE selects core or full. Neither one is dev mode.
# DMS_AUTH_DISABLED is honored only when CORTEX_DEV_MODE is also 1, true, or yes.
# Otherwise startup raises AUTH_DISABLED_WITHOUT_DEV_MODE and logs that name.
CORTEX_DEV_MODE=1
DMS_AUTH_DISABLED=1
PACK=dms
