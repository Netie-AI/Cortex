# Cortex DMS demo — copy to env.local in repo root (never commit env.local)
# Required for live LLM features (chat brain, task suggest). Demo runs without keys in mock mode.

# Primary LLM (Anthropic Claude — used by brain + task suggest)
ANTHROPIC_API_KEY=

# Optional fast inference fallbacks (not required for core demo)
GROQ_API_KEY=
OPENROUTER_API_KEY=
SEA_LION_API_KEY=

# DMS paths (defaults work out of the box; override if needed)
DMS_OPS_DB=packs/data/dms_ops.db
# DMS_LEDGER_DSN=postgresql://user:pass@localhost:5432/dms_ledger

# Field encryption for sensitive warehouse data (generate for prod)
# DMS_MASTER_KEY=

# Demo API keys are set by run_demo.ps1 — override only for custom roles:
# DMS_API_KEYS=viewer:your-viewer-key;steward:your-steward-key;admin:your-admin-key
