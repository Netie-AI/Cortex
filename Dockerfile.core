# syntax=docker/dockerfile:1
# cortex:${VERSION}-core — base install (answer plane)
ARG PYTHON_VERSION=3.11
FROM python:${PYTHON_VERSION}-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CORTEX_PROFILE=core \
    PACK=dms
# Auth is on (T2-FAILCLOSED, #263). Pass DMS_API_KEYS or pair OpenVault via
# OPENVAULT_BASE_URL at run time; with neither, every gated request is refused.
# Never bake keys into this image.

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY netie ./netie
COPY CortexOS ./CortexOS
COPY packs ./packs
COPY packages ./packages
COPY contract ./contract

# Supply chain (R13.1, HX-02): every third-party wheel is exact-pinned and
# hash-checked from requirements/image-core.lock.txt (scripts/lock_images.py,
# never hand-edited), then the project goes in with --no-deps. No build
# isolation, so the build backend is the hashed poetry-core from the lock.
COPY requirements/image-core.lock.txt ./requirements/
RUN pip install --no-cache-dir --only-binary :all: --require-hashes \
        -r requirements/image-core.lock.txt \
    && pip install --no-cache-dir --no-deps --no-build-isolation .

EXPOSE 8010
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8010/health || exit 1

CMD ["python", "-m", "uvicorn", "CortexOS.api.main:app", "--host", "0.0.0.0", "--port", "8010"]
