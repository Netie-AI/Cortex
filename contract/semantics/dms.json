{
  "measures": [
    {
      "description": "Sales value in MYR. A sale is an outbound movement; inbound, ADJUST and WRITE_OFF rows are not sales.",
      "expression": "SUM(quantity_kg * unit_cost_myr)",
      "filter": {
        "column": "txn_type",
        "equals": "outbound"
      },
      "grain": "txn_id",
      "metrics": [
        "sales_by_value",
        "revenue_total",
        "revenue_windowed",
        "revenue_last_month"
      ],
      "name": "sales_value_myr",
      "table": "transactions"
    },
    {
      "description": "Quantity sold in kg. A sale is an outbound movement.",
      "expression": "SUM(quantity_kg)",
      "filter": {
        "column": "txn_type",
        "equals": "outbound"
      },
      "grain": "txn_id",
      "metrics": [
        "sales_by_volume"
      ],
      "name": "sales_volume_kg",
      "table": "transactions"
    }
  ],
  "pack": "dms",
  "source": "packs/dms/ontology/object_types.yaml",
