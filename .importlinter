[importlinter]
root_packages =
    CortexOS
    packs
# Required so contract 3 can forbid n8n/langchain/langflow/gencfsm without
# vendoring them. Contract 1 then also sees function-level packs imports that
# grimp previously skipped; those already live on the AST C2 allowlist.
include_external_packages = True

[importlinter:contract:1]
name = the engine never reaches into a pack (C2 boundary)
type = forbidden
source_modules =
    CortexOS
forbidden_modules =
    packs
# Packs register into the engine; the engine only ever holds a port. Enforced at
# lint as well as in tests/contract/test_import_boundaries.py, because a single
# AST test is one file away from being skipped and this boundary is permanent.
# The allowlist in that test is pre-C2 debt being evacuated, so this contract
# ignores those known imports rather than pretending they are gone.
ignore_imports =
    CortexOS.api.engine_routes -> packs.**
    CortexOS.api.chat_routes -> packs.**
    CortexOS.api.skill_routes -> packs.**
    CortexOS.api.task_routes -> packs.**
    CortexOS.api.agent_routes -> packs.**
    CortexOS.api.brain_routes -> packs.**
    CortexOS.api.ingest_routes -> packs.**
    CortexOS.api.lakehouse_routes -> packs.**
    CortexOS.api.memory_routes -> packs.**
    CortexOS.api.pipeline_routes -> packs.**
    CortexOS.api.stream_routes -> packs.**
    CortexOS.api.warehouse_routes -> packs.**
    CortexOS.api.action_routes -> packs.**
    CortexOS.api.sidecar_routes -> packs.**
    CortexOS.api.a2a_routes -> packs.**
    CortexOS.api.mcp_routes -> packs.**
    CortexOS.api.discovery_routes -> packs.**
    CortexOS.api.app -> packs.**
    CortexOS.api.telemetry_routes -> packs.**
    CortexOS.api.context_routes -> packs.**
    CortexOS.dms.query_service -> packs.**
    CortexOS.dms.seed_demo -> packs.**
    CortexOS.dms.answer_engine -> packs
    CortexOS.nlp.local_inference -> packs.**
    CortexOS.execution.tool_runner -> packs.**
    CortexOS.ponytail.middleware -> packs.**
    CortexOS.ontology.registry -> packs.**

[importlinter:contract:2]
name = packaging helpers stay independent of optional planes
type = independence
modules =
    CortexOS.packaging
independent_from =
    CortexOS.rag
    CortexOS.execution.dag_runner
    CortexOS.execution.osr
    CortexOS.execution.seeker

[importlinter:contract:3]
name = constructor engine never imports n8n/langchain/langflow/gencfsm as engine
type = forbidden
source_modules =
    CortexOS.constructor_graph
    CortexOS.execution.distill_options
    CortexOS.execution.rsf_boundary
    CortexOS.execution.rsf_orchestrator
    CortexOS.execution.rsf_eval
    CortexOS.execution.rsf_operate
    CortexOS.execution.distill_harness
forbidden_modules =
    n8n
    langchain
    langchain_core
    langchain_community
    langflow
    langgraph
    gencfsm

[importlinter:contract:4]
name = per-Space memory never reaches a model, a pack, a DB driver or the answer plane (C-MEM #290)
type = forbidden
source_modules =
    CortexOS.memory.space_memory
forbidden_modules =
    packs
    duckdb
    litellm
    httpx
    CortexOS.integrations
    CortexOS.crew
    CortexOS.nlp
    CortexOS.execution
    CortexOS.dms
    CortexOS.api
# The store holds entries and stamps only. Reuse and real-result checks run SQL
# through an executor the caller injects, so the store never holds a source-DB
# handle, never calls a model, and can never serve an answer it did not re-run.
# Must-fail: tests/test_memory/test_c_mem_import_contract.py.

[importlinter:contract:plan-sql-freeroute-only]
name = the plan+SQL path reaches a model only through OpenVault FreeRoute (C-LOOP-A #303)
type = forbidden
source_modules =
    CortexOS.plan_sql
forbidden_modules =
    openai
    anthropic
    groq
    litellm
    cohere
    mistralai
    together
    ollama
    cerebras
    google
    vertexai
    boto3
    botocore
    huggingface_hub
    transformers
    httpx
    requests
    aiohttp
    urllib3
    langchain
    langchain_core
    langchain_community
    langgraph
    llama_index
    CortexOS.routing
    CortexOS.crew
    CortexOS.nlp
    CortexOS.fabrication
    packs
    duckdb
    CortexOS.execution
    CortexOS.dms
    CortexOS.api
# The generator builds prompts and reads model text. Its one model path is
# CortexOS.integrations.freeroute (OpenVault custody, arming, served_* stamps);
# no provider SDK, HTTP client, or other Cortex model router. It holds no
# executor or DB handle: CortexOS.dms.plan_sql_ask gates and executes the SQL.
# Must-fail: tests/test_plan_sql/test_c_loop_a_import_contract.py::test_must_fail_import_contract_breaks.
